Grammar

    0 $accept: start "<EOF>"

    1 start: "<program>" program
    2      | "<define>" define

    3 program: program statement
    4        | %empty

    5 statement: error "."

    6 identifier: "<IDENTIFIER>"

    7 constterm: constterm "^" constterm
    8          | constterm "?" constterm
    9          | constterm "&" constterm
   10          | constterm "+" constterm
   11          | constterm "-" constterm
   12          | constterm "*" constterm
   13          | constterm "/" constterm
   14          | constterm "\\" constterm
   15          | constterm "**" constterm
   16          | "-" constterm
   17          | "~" constterm
   18          | "(" ")"
   19          | "(" "," ")"
   20          | "(" consttermvec ")"
   21          | "(" consttermvec "," ")"
   22          | identifier "(" constargvec ")"
   23          | "@" identifier "(" constargvec ")"
   24          | "|" constterm "|"
   25          | identifier
   26          | "<NUMBER>"
   27          | "<STRING>"
   28          | "#inf"
   29          | "#sup"

   30 consttermvec: constterm
   31             | consttermvec "," constterm

   32 constargvec: consttermvec
   33            | %empty

   34 term: term ".." term
   35     | term "^" term
   36     | term "?" term
   37     | term "&" term
   38     | term "+" term
   39     | term "-" term
   40     | term "*" term
   41     | term "/" term
   42     | term "\\" term
   43     | term "**" term
   44     | "-" term
   45     | "~" term
   46     | "(" tuplevec ")"
   47     | identifier "(" argvec ")"
   48     | "@" identifier "(" argvec ")"
   49     | "|" unaryargvec "|"
   50     | identifier
   51     | "<NUMBER>"
   52     | "<STRING>"
   53     | "#inf"
   54     | "#sup"
   55     | "<VARIABLE>"
   56     | "<ANONYMOUS>"

   57 unaryargvec: term
   58            | unaryargvec ";" term

   59 ntermvec: term
   60         | ntermvec "," term

   61 termvec: ntermvec
   62        | %empty

   63 tuple: ntermvec ","
   64      | ntermvec
   65      | ","
   66      | %empty

   67 tuplevec_sem: tuple ";"
   68             | tuplevec_sem tuple ";"

   69 tuplevec: tuple
   70         | tuplevec_sem tuple

   71 argvec: termvec
   72       | argvec ";" termvec

   73 cmp: ">"
   74    | "<"
   75    | ">="
   76    | "<="
   77    | "="
   78    | "!="

   79 atom: identifier
   80     | identifier "(" argvec ")"
   81     | "-" identifier
   82     | "-" identifier "(" argvec ")"

   83 literal: "#true"
   84        | "not" "#true"
   85        | "not" "not" "#true"
   86        | "#false"
   87        | "not" "#false"
   88        | "not" "not" "#false"
   89        | atom
   90        | "not" atom
   91        | "not" "not" atom
   92        | term cmp term
   93        | "not" term cmp term
   94        | "not" "not" term cmp term
   95        | csp_literal

   96 csp_mul_term: "$" term "$*" term
   97             | term "$*" "$" term
   98             | "$" term
   99             | term

  100 csp_add_term: csp_add_term "$+" csp_mul_term
  101             | csp_add_term "$-" csp_mul_term
  102             | csp_mul_term

  103 csp_rel: "$>"
  104        | "$<"
  105        | "$>="
  106        | "$<="
  107        | "$="
  108        | "$!="

  109 csp_literal: csp_literal csp_rel csp_add_term
  110            | csp_add_term csp_rel csp_add_term

  111 nlitvec: literal
  112        | nlitvec "," literal

  113 litvec: nlitvec
  114       | %empty

  115 optcondition: ":" litvec
  116             | %empty

  117 noptcondition: ":" nlitvec
  118              | %empty

  119 aggregatefunction: "#sum"
  120                  | "#sum+"
  121                  | "#min"
  122                  | "#max"
  123                  | "#count"

  124 bodyaggrelem: ":" litvec
  125             | ntermvec optcondition

  126 bodyaggrelemvec: bodyaggrelem
  127                | bodyaggrelemvec ";" bodyaggrelem

  128 altbodyaggrelem: literal optcondition

  129 altbodyaggrelemvec: altbodyaggrelem
  130                   | altbodyaggrelemvec ";" altbodyaggrelem

  131 bodyaggregate: "{" "}"
  132              | "{" altbodyaggrelemvec "}"
  133              | aggregatefunction "{" "}"
  134              | aggregatefunction "{" bodyaggrelemvec "}"

  135 upper: term
  136      | cmp term
  137      | %empty

  138 lubodyaggregate: term bodyaggregate upper
  139                | term cmp bodyaggregate upper
  140                | bodyaggregate upper

  141 headaggrelemvec: headaggrelemvec ";" termvec ":" literal optcondition
  142                | termvec ":" literal optcondition

  143 altheadaggrelemvec: literal optcondition
  144                   | altheadaggrelemvec ";" literal optcondition

  145 headaggregate: aggregatefunction "{" "}"
  146              | aggregatefunction "{" headaggrelemvec "}"
  147              | "{" "}"
  148              | "{" altheadaggrelemvec "}"

  149 luheadaggregate: term headaggregate upper
  150                | term cmp headaggregate upper
  151                | headaggregate upper

  152 ncspelemvec: termvec ":" csp_add_term optcondition
  153            | cspelemvec ";" termvec ":" csp_add_term optcondition

  154 cspelemvec: ncspelemvec
  155           | %empty

  156 disjoint: "#disjoint" "{" cspelemvec "}"
  157         | "not" "#disjoint" "{" cspelemvec "}"
  158         | "not" "not" "#disjoint" "{" cspelemvec "}"

  159 conjunction: literal ":" litvec

  160 dsym: ";"
  161     | "|"

  162 disjunctionsep: disjunctionsep literal ","
  163               | disjunctionsep literal noptcondition dsym
  164               | %empty

  165 disjunction: literal "," disjunctionsep literal noptcondition
  166            | literal dsym disjunctionsep literal noptcondition
  167            | literal ":" nlitvec dsym disjunctionsep literal noptcondition
  168            | literal ":" nlitvec

  169 bodycomma: bodycomma literal ","
  170          | bodycomma literal ";"
  171          | bodycomma lubodyaggregate ","
  172          | bodycomma lubodyaggregate ";"
  173          | bodycomma "not" lubodyaggregate ","
  174          | bodycomma "not" lubodyaggregate ";"
  175          | bodycomma "not" "not" lubodyaggregate ","
  176          | bodycomma "not" "not" lubodyaggregate ";"
  177          | bodycomma conjunction ";"
  178          | bodycomma disjoint ";"
  179          | %empty

  180 bodydot: bodycomma literal "."
  181        | bodycomma lubodyaggregate "."
  182        | bodycomma "not" lubodyaggregate "."
  183        | bodycomma "not" "not" lubodyaggregate "."
  184        | bodycomma conjunction "."
  185        | bodycomma disjoint "."

  186 head: literal
  187     | disjunction
  188     | luheadaggregate

  189 statement: head "."
  190          | head ":-" bodydot
  191          | ":-" bodydot
  192          | ":-" "."
  193          | disjoint ":-" bodydot
  194          | disjoint ":-" "."
  195          | disjoint "."

  196 optimizetuple: "," ntermvec
  197              | %empty

  198 optimizeweight: term "@" term
  199               | term

  200 optimizelitvec: literal
  201               | optimizelitvec "," literal

  202 optimizecond: ":" optimizelitvec
  203             | ":"
  204             | %empty

  205 statement: ":~" bodydot "[" optimizeweight optimizetuple "]"
  206          | ":~" "." "[" optimizeweight optimizetuple "]"

  207 maxelemlist: optimizeweight optimizetuple optimizecond
  208            | maxelemlist ";" optimizeweight optimizetuple optimizecond

  209 minelemlist: optimizeweight optimizetuple optimizecond
  210            | minelemlist ";" optimizeweight optimizetuple optimizecond

  211 statement: "#minimize" "{" "}" "."
  212          | "#maximize" "{" "}" "."
  213          | "#minimize" "{" minelemlist "}" "."
  214          | "#maximize" "{" maxelemlist "}" "."
  215          | "#showsig" "<IDENTIFIER>" "/" "<NUMBER>" "."
  216          | "#showsig" "-" "<IDENTIFIER>" "/" "<NUMBER>" "."
  217          | "#show" "."
  218          | "#show" term ":" bodydot
  219          | "#show" term "."
  220          | "#showsig" "$" "<IDENTIFIER>" "/" "<NUMBER>" "."
  221          | "#show" "$" term ":" bodydot
  222          | "#show" "$" term "."

  223 define: identifier "=" constterm

  224 statement: "#const" identifier "=" constterm "."
  225          | "<PYTHON>" "."
  226          | "<LUA>" "."
  227          | "#include" "<STRING>" "."
  228          | "#include" "<" "<IDENTIFIER>" ">" "."

  229 nidlist: nidlist "," "<IDENTIFIER>"
  230        | "<IDENTIFIER>"

  231 idlist: %empty
  232       | nidlist

  233 statement: "#program" "<IDENTIFIER>" "(" idlist ")" "."
  234          | "#program" "<IDENTIFIER>" "."
  235          | "#external" atom ":" bodydot
  236          | "#external" atom ":" "."
  237          | "#external" atom "."


